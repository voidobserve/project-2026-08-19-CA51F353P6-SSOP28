  40   1      
  41   1          /*
  42   1              两组级联 共用 DCK 和 LAT，
  43   1              因此一帧的时钟数必须等于最大的级联数（AIP3368_MAX_IC_NUM = 8 个字）。
  44   1      
  45   1              移位寄存器型级联：先发的数据会填充到最远端的芯片，
  46   1              发多了的字会从级联链末端移出而丢失（不是“截取前一段再转发”）。
  47   1              所以级联数较少的一组，数据必须从帧的“末尾”开始发送：
  48   1              字偏移 offset = AIP3368_MAX_IC_NUM - 本组级联数。
  49   1      
  50   1              例如：时速面板 6 颗，发动机转速面板 8 颗，
  51   1              时速面板 offset = 8 - 6 = 2，其 6 个字占帧的第 2~7 个位置，
  52   1              恰好落在 6 颗芯片上，前面 2 个字补 0（被移出丢失，无影响）。
C51 COMPILER V9.60.7.0   AIP3368                                                           08/28/2026 18:50:04 PAGE 2   

  53   1              发动机转速面板 offset = 0，8 个字正好占满整帧。
  54   1          */
  55   1          volatile u8 offset_group_1 = AIP3368_MAX_IC_NUM - len_group_1;
  56   1          volatile u8 offset_group_2 = AIP3368_MAX_IC_NUM - len_group_2;
  57   1      
  58   1          // 开始
  59   1          DCK = 0;
  60   1          LAT = 0;
  61   1          aip3368h_delay();
  62   1      
  63   1          // 一帧完整数据
  64   1          for (i = 0; i < AIP3368_MAX_IC_NUM; i++) {
  65   2              // 本组数据在帧中的位置：i < offset 的部分补 0（会被移出级联链）
  66   2              dat_group_1 = 0;
  67   2              dat_group_2 = 0;
  68   2      
  69   2              if (i >= offset_group_1) {
  70   3                  dat_group_1 = buff_group_1[i - offset_group_1];
  71   3              }
  72   2      
  73   2              // if (i < len_group_1) {
  74   2              //     dat_group_1 = buff_group_1[i];
  75   2              // }
  76   2      
  77   2              if (i >= offset_group_2) {
  78   3                  dat_group_2 = buff_group_2[i - offset_group_2];
  79   3              }
  80   2      
  81   2              // if (i < len_group_2) {
  82   2              //     dat_group_2 = buff_group_2[i];
  83   2              // }
  84   2      
  85   2              for (j = 0; j < 16; j++) {
  86   3                  DIO_GROUP_1 = dat_group_1 & (u16)0x8000 ? 1 : 0;
  87   3                  DIO_GROUP_2 = dat_group_2 & (u16)0x8000 ? 1 : 0;
  88   3      
  89   3                  aip3368h_delay();
  90   3                  DCK = 1;
  91   3                  aip3368h_delay();
  92   3      
  93   3                  dat_group_1 <<= 1;
  94   3                  dat_group_2 <<= 1;
  95   3      
  96   3                  DCK = 0;
  97   3                  aip3368h_delay();
  98   3              }
  99   2          }
 100   1      
 101   1          // 结束
 102   1          LAT = 1;
 103   1          aip3368h_delay();
 104   1          LAT = 0;
 105   1          aip3368h_delay();
 106   1          DIO_GROUP_1 = 0;
 107   1          DIO_GROUP_2 = 0;
 108   1      }
