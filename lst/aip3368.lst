  31          static void aip3368h_module_send_data_to_all_dev(const u16 *buff_group_1,
  32                                                           const u8 len_group_1,
  33                                                           const u16 *buff_group_2,
  34                                                           const u8 len_group_2)
  35          {
  36   1          volatile u8 i;
  37   1          volatile u8 j;
  38   1          volatile u16 dat_group_1;
  39   1          volatile u16 dat_group_2;
  40   1      
  41   1          /*
  42   1              两组级联（时速面板 6 颗、发动机转速面板 8 颗）共用 DCK 和 LAT，
  43   1              因此一帧的时钟数必须等于最大的级联数（AIP3368_MAX_IC_NUM = 8 个字）。
  44   1      
  45   1              移位寄存器型级联：先发的数据会填充到最远端的芯片，
  46   1              发多了的字会从级联链末端移出而丢失（不是“截取前一段再转发”）。
  47   1              所以级联数较少的一组，数据必须从帧的“末尾”开始发送：
  48   1              字偏移 offset = AIP3368_MAX_IC_NUM - 本组级联数。
  49   1              时速面板 offset = 8 - 6 = 2，其 6 个字占帧的第 2~7 个位置，
  50   1              恰好落在 6 颗芯片上，前面 2 个字补 0（被移出丢失，无影响）。
  51   1              发动机转速面板 offset = 0，8 个字正好占满整帧。
  52   1          */
  53   1          volatile u8 offset_group_1 = AIP3368_MAX_IC_NUM - len_group_1;
C51 COMPILER V9.60.7.0   AIP3368                                                           08/20/2026 18:20:02 PAGE 2   

  54   1          volatile u8 offset_group_2 = AIP3368_MAX_IC_NUM - len_group_2;
  55   1      
  56   1          // 开始
  57   1          DCK = 0;
  58   1          LAT = 0;
  59   1          aip3368h_delay();
  60   1      
  61   1          // 一帧完整数据
  62   1          for (i = 0; i < AIP3368_MAX_IC_NUM; i++) {
  63   2              // 本组数据在帧中的位置：i < offset 的部分补 0（会被移出级联链）
  64   2              dat_group_1 = 0;
  65   2              dat_group_2 = 0;
  66   2      
  67   2              if (i >= offset_group_1) {
  68   3                  dat_group_1 = buff_group_1[i - offset_group_1];
  69   3              }
  70   2      
  71   2              if (i >= offset_group_2) {
  72   3                  dat_group_2 = buff_group_2[i - offset_group_2];
  73   3              }
  74   2      
  75   2              for (j = 0; j < 16; j++) {
  76   3                  DIO_GROUP_1 = dat_group_1 & (u16)0x8000 ? 1 : 0;
  77   3                  DIO_GROUP_2 = dat_group_2 & (u16)0x8000 ? 1 : 0;
  78   3      
  79   3                  aip3368h_delay();
  80   3                  DCK = 1;
  81   3                  aip3368h_delay();
  82   3      
  83   3                  dat_group_1 <<= 1;
  84   3                  dat_group_2 <<= 1;
  85   3      
  86   3                  DCK = 0;
  87   3                  aip3368h_delay();
  88   3              }
  89   2          }
  90   1      
  91   1          // 结束
  92   1          LAT = 1;
  93   1          aip3368h_delay();
  94   1          LAT = 0;
  95   1          aip3368h_delay();
  96   1          DIO_GROUP_1 = 0;
  97   1          DIO_GROUP_2 = 0;
  98   1      }
