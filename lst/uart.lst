  55          /**
  56           * @brief 发送一个字节数据
  57           * 
  58           * 往发送缓冲区中存放数据，通过串口中断发送
  59           * 
  60           * @note 会阻塞主循环，直到发送完成
  61           *      如果缓冲区有空间，则存放数据。如果缓冲区已满，则等待
  62           * 
  63           */
  64          void uart1_send_byte(unsigned char byte)
  65          {
  66   1          unsigned char free_space;
  67   1          unsigned char tail_tmp;
  68   1      
  69   1          while (1) {
  70   2              tail_tmp = uart1_drv_tx_info.tail;
  71   2              if (uart1_drv_tx_info.head < tail_tmp) {
  72   3                  // 头指针在尾指针前面
  73   3                  free_space = tail_tmp - uart1_drv_tx_info.head;
  74   3              } else {
  75   3                  // 头指针在尾指针后面
  76   3                  free_space = UART1_TX_BUF_SIZE + tail_tmp - uart1_drv_tx_info.head;
  77   3              }
  78   2      
  79   2              // 如果缓冲区有空间，则存放数据。如果缓冲区已满，则等待
  80   2              if (free_space > 1) {
  81   3                  ES1 = 0; // 不使能UART1中断
  82   3      
  83   3                  // 先偏移指针，再存放数据
  84   3                  uart1_drv_tx_info.head++;
  85   3                  uart1_drv_tx_info.head %= UART1_TX_BUF_SIZE;
  86   3                  uart1_drv_tx_info.buff[uart1_drv_tx_info.head] = byte;
  87   3      
  88   3                  if (!uart1_tx_busy_flag) {
  89   4                      // 如果上一次发送已经完成，则立即发送
  90   4                      ES1 = 1;
  91   4                      uart1_drv_tx_info.tail++;
  92   4                      uart1_drv_tx_info.tail %= UART1_TX_BUF_SIZE;
  93   4                      S1BUF = uart1_drv_tx_info.buff[uart1_drv_tx_info.tail];
  94   4                      uart1_tx_busy_flag = 1;
  95   4                  } else {
  96   4                      ES1 = 1;
  97   4                  }
  98   3      
  99   3                  break;
 100   3              }
