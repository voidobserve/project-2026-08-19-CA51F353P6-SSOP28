                              uart0_send.tail++;
                              uart0_send.tail %= UART0_TX_BUF_SIZE;
                              S0BUF = uart0_tx_buf[uart0_send.tail];
                              uart0_tx_flag = 1;
                          } else {
                              ES0 = 1;
                          }
                          break;
                      }
