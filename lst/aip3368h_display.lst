 212          void aip3368h_display_engine_speed_lev(u8 lev)
 213          {
 214   1          // 清空原来的显示
 215   1          u8 i;
 216   1      
 217   1          for (i = 0; i < ARRAY_SIZE(engine_speed_gear_map); i++) {
 218   2              if (lev < i) {
