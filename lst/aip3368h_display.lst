 222   3                      ~(0x01 << engine_speed_gear_map[i].bit_offset);
 223   3              } else {
 224   3                  // 如果传参的挡位，大于等于当前遍历的挡位
 225   3                  aip3368h_engine_speed_panel_display_buff[engine_speed_gear_map[i]
 226   3                                                               .buff_index] |=
 227   3                      (0x01 << engine_speed_gear_map[i].bit_offset);
 228   3              }
 229   2          }
 230   1      }
