1044   2              aip3368h_speed_panel_display_buff[fuel_lev_left_map[idx].buff_index] &=
1045   2                  ~(0x01 << fuel_lev_left_map[idx].bit_offset);
1046   2              aip3368h_speed_panel_display_buff[fuel_lev_right_map[idx].buff_index] &=
1047   2                  ~(0x01 << fuel_lev_right_map[idx].bit_offset);
1048   2          }
1049   1      }
1050          
1051          /**
1052           * @brief 油量格数显示
1053           *
1054           * @param lev 0 ~ ARRYA_SIZE(fuel_lev_map)
1055           *      0：不显示
1056           *      1：显示第 0 格
1057           *      2：显示 0 ~ 1 格
1058           *      ARRYA_SIZE(fuel_lev_map)：显示 0 ~ ARRYA_SIZE(fuel_lev_map) - 1 格
1059           *
1060           */
1061          void aip3368h_display_fuel_lev(u8 lev)
1062          {
1063   1          u8 i;
1064   1          for (i = 0; i < ARRAY_SIZE(fuel_lev_left_map); i++) {
1065   2              if (lev <= i) {
1066   3                  // 如果当前传参的值，比当前遍历的值还要小，清空对应的显示
1067   3                  __aip3368h_display_fuel_lev__(i, 0);
1068   3              } else if ((lev - i) > 0) {
1069   3                  // 如果当前传参的值，比当前遍历的值还要大（至少要大于等于1），显
             -示对应的指示灯
1070   3                  __aip3368h_display_fuel_lev__(i, 1);
1071   3              }
1072   2          }
1073   1      }
