1034           *
1035           */
1036          void __aip3368h_display_fuel_lev__(u8 idx, u8 is_display)
1037          {
1038   1          if (is_display) {
1039   2              aip3368h_speed_panel_display_buff[fuel_lev_left_map[idx].buff_index] |=
1040   2                  (0x01 << fuel_lev_left_map[idx].bit_offset);
1041   2              aip3368h_speed_panel_display_buff[fuel_lev_right_map[idx].buff_index] |=
1042   2                  (0x01 << fuel_lev_right_map[idx].bit_offset);
