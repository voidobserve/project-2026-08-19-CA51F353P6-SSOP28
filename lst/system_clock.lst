  62          输入参数：              Multiple   倍频倍数
  63          返回值  ：              无
  64          ***********************************************************************************/
  65          void Sys_Clk_Set_PLL(unsigned char Multiple)
  66          {
  67   1          if (Multiple < 2 || Multiple > 8)
  68   1              return; //倍频倍数范围为 2~8，超出此范围返回
  69   1      
  70   1          PLLCON = PLLON(1) | MULFT(Multiple - 2); // 设置倍频倍数并使能PLL
  71   1          while (!(PLLCON & PLSTA))
  72   1              ;                               // 等待PLL时钟稳定
  73   1          CKSEL = (CKSEL & 0xF8) | CKSEL_PLL; // 切换系统时钟到PLL
  74   1      }
