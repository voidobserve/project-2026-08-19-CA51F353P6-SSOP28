  38          u8 bat_vol_to_lev(u16 voltage)
  39          {
  40   1          u8 ret = 0;
  41   1      
  42   1          if (voltage >= BAT_VOLTAGE_OF_FULL_GRID) {
  43   2              ret = 7;
