  58   2          } else if (voltage >= BAT_VOLTAGE_OF_LOW_GRID) {
  59   2              /*
  60   2                  关闭 1 格显示时，9V 起从 2 格开始
  61   2                  有如下线性关系：
  62   2                  (16000 - 9000) / (7 - 2) == 7000 / 5
  63   2                  每mV对应 5 / 7000 格
  64   2                  公式里的 + 3500 作为四舍五入
  65   2              */
  66   2              ret = 2 + (((u32)voltage - BAT_VOLTAGE_OF_LOW_GRID) * 5 + 3500) / 7000;
  67   2              if (ret > 7) {
  68   3                  ret = 7;
  69   3              }
  70   2          } else {
