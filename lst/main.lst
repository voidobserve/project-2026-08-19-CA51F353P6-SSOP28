  33          void SystemInit(void)
  34          {
  35   1      #ifdef LVD_RST_ENABLE
  36   1          LVDCON = 0xE1; //设置LVD复位电压为2V
  37   1      #endif
  38   1      
  39   1      #if (SYSCLK_SRC == PLL)
  40   1          Sys_Clk_Set_PLL(PLL_Multiple);
  41   1      #endif
  42   1      
  43   1      /***************************看门狗阈值设置计算公式如下****************************
  44   1      看门狗触发时间 = (WDVTH * 800H+7FFH) * clock cycle
  45   1      当看门狗时钟为3.6864M时,时间覆盖范围为0.56ms--36s
  46   1      *********************************************************************************/
  47   1      //备注：需默认开启看门狗功能，并将其设置为复位模式
  48   1      #if (RTC_CLK_SELECT == IRCL)
  49   1          CKCON |= ILCKE; //使能IRCL
  50   1          WDCON = WDTS(WDTS_IRCL) |
  51   1                  WDRE(WDRE_reset); //设置看门狗时钟源为IRCL，模式为复位模式
  52   1      #elif (RTC_CLK_SELECT == XOSCL)
                  CKCON |= XLCKE;
C51 COMPILER V9.60.7.0   MAIN                                                              08/29/2026 16:30:41 PAGE 2   

                  while (!(CKCON & XLSTA))
                      ;
                  WDCON = WDTS(WDTS_XOSCL) |
                          WDRE(WDRE_reset); //设置看门狗时钟源为XOSCL，模式为复位模式
              #endif
  59   1      
  60   1          WDVTHH = 0;  // 看门狗复位阈值高八位设置 当前值为 5s
  61   1          WDVTHL = 75; // 看门狗复位阈值低八位设置
  62   1          WDFLG = 0xA5;
  63   1      }
