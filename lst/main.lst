  37   1      /***************************看门狗阈值设置计算公式如下****************************
  38   1      看门狗触发时间 = (WDVTH * 800H+7FFH) * clock cycle
  39   1      当看门狗时钟为3.6864M时,时间覆盖范围为0.56ms--36s
  40   1      *********************************************************************************/
  41   1      //备注：需默认开启看门狗功能，并将其设置为复位模式
  42   1      #if (RTC_CLK_SELECT == IRCL)
  43   1          CKCON |= ILCKE; //使能IRCL
  44   1          WDCON = WDTS(WDTS_IRCL) |
  45   1                  WDRE(WDRE_reset); //设置看门狗时钟源为IRCL，模式为复位模式
  46   1      #elif (RTC_CLK_SELECT == XOSCL)
                  CKCON |= XLCKE;
                  while (!(CKCON & XLSTA))
                      ;
                  WDCON = WDTS(WDTS_XOSCL) |
                          WDRE(WDRE_reset); //设置看门狗时钟源为XOSCL，模式为复位模式
              #endif
  53   1      
