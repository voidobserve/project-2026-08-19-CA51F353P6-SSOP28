                  // 3 档 检测脚：
                  P1_PU |= GPIO_P13_PULL_UP(0x01);      // 上拉
                  P1_MD0 &= ~(GPIO_P13_MODE_SEL(0x03)); // 输入模式
              
                  // 4 档 检测脚：
                  P2_PU |= GPIO_P20_PULL_UP(0x01);      // 上拉
                  P2_MD0 &= ~(GPIO_P20_MODE_SEL(0x03)); // 输入模式
              
                  // 5 档 检测脚：
